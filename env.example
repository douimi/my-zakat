# Copy this file to .env for local development or env.production for production
# Replace all placeholder values with your actual credentials

# Stripe Configuration (Get these from your Stripe dashboard)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database Configuration
DATABASE_URL=postgresql://postgres:password@db:5432/myzakat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Application Security (Generate a strong random key for production)
SECRET_KEY=your-super-secret-key-change-in-production

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Email Verification Configuration (Network Solutions)
SMTP_SERVER=netsol-smtp-xxxx.hostingplatform.com
SMTP_PORT=587
SMTP_USERNAME=info@yourdomain.org
SMTP_PASSWORD=************
EMAIL_FROM_NAME=Your App Name

# Application URLs (adjust for your environment)
# For local development, use http://localhost:3000
# For production, use your actual domain (e.g., https://myzakat.org)
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# S3/MinIO Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=myzakat-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000

# Object-store image. MinIO withdrew its community images from Docker Hub and
# quay.io in September 2026 and archived the OSS repo, so the tag production
# still runs cannot be pulled any more — it survives only as a local cache on
# the VPS. Leave this unset to keep whatever each compose file defaults to.
# Set it to pin a mirror of your own, or to move to the maintained community
# fork of the same codebase:
#   MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_IMAGE=

# Backend log verbosity. INFO is the quiet steady state: donation/webhook events,
# admin changes, and everything at warning or above. DEBUG additionally restores
# per-upload progress lines and third-party HTTP request logs -- useful while
# troubleshooting, far too much for normal running.
LOG_LEVEL=INFO

# Nisab — live gold/silver prices for the zakat threshold shown by GET /api/nisab.
# Optional: with no key the site degrades quietly and shows the method (a mass of
# gold, a mass of silver) instead of a dollar figure. Key from https://metals.dev.
METALS_API_KEY=your_metals_dev_api_key_here
METALS_API_URL=https://api.metals.dev/v1/latest
