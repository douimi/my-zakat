{
  "uid": "myzakat-activity",
  "title": "Platform activity",
  "description": "Everything that is not the money path -- see the Donations dashboard for that. Panels filter on logfmt fields (level, event) rather than matching prose or emoji, which is why the previous version of this dashboard went blank whenever a log message was reworded.",
  "tags": ["myzakat", "activity"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"]
  },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Errors",
      "description": "level=error from any service. The level label is parsed from the logfmt level= key, not guessed from the line.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [{ "options": { "match": "null", "result": { "text": "0" } }, "type": "special" }]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto",
        "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "sum(count_over_time({level=\"error\"} [$__range]))"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Failed requests",
      "description": "event=request.failed -- every 4xx/5xx the app returned, from the audit middleware, whichever endpoint it hit.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "mappings": [{ "options": { "match": "null", "result": { "text": "0" } }, "type": "special" }]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto",
        "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"backend\"} | logfmt | event=\"request.failed\" [$__range]))"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Logins",
      "description": "event=auth.login",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "decimals": 0,
          "unit": "short",
          "mappings": [{ "options": { "match": "null", "result": { "text": "0" } }, "type": "special" }]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto",
        "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"backend\"} | logfmt | path=\"/api/auth/login\" | status=~\"2..\" [$__range]))"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Services reporting",
      "description": "How many containers Promtail is currently shipping logs for. If this drops, the gap is in the log pipeline, not necessarily in the app -- which is the distinction that used to be impossible to make from Grafana.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "none", "textMode": "auto",
        "justifyMode": "auto", "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "count(count by (container) (count_over_time({container=~\".+\"} [$__range])))"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Log volume by level",
      "description": "One axis, counts. Useful as the first thing to look at after a deploy: a step change in errors shows here before anyone reports it.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "axisLabel": "lines",
            "gradientMode": "none",
            "spanNulls": false
          },
          "decimals": 0,
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "legendFormat": "{{level}}",
          "expr": "sum by (level) (count_over_time({level=~\".+\"} [$__interval]))"
        }
      ]
    },

    {
      "type": "row",
      "title": "Problems",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 20,
      "type": "logs",
      "title": "Errors and warnings, all services",
      "description": "Anything at warning or above, newest first, with error and stack on the same line as the message they belong to.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "{level=~\"error|warning|critical|fatal\"}"
        }
      ]
    },

    {
      "type": "row",
      "title": "Admin activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": true,
      "panels": [
        {
          "id": 30,
          "type": "logs",
          "title": "Who changed what",
          "description": "event=content.changed from the audit middleware: one line per state-changing request, with the actor, the endpoint and how long it took. Reads are not audited.",
          "datasource": { "type": "loki", "uid": "loki" },
          "gridPos": { "h": 14, "w": 24, "x": 0, "y": 29 },
          "options": {
            "showTime": true,
            "showLabels": false,
            "showCommonLabels": false,
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "dedupStrategy": "none",
            "sortOrder": "Descending"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "loki", "uid": "loki" },
              "queryType": "range",
              "expr": "{service=\"backend\"} | logfmt | event=\"content.changed\""
            }
          ]
        },
        {
          "id": 31,
          "type": "logs",
          "title": "Everything, unfiltered",
          "description": "The raw tail across all containers, for when you do not yet know what you are looking for.",
          "datasource": { "type": "loki", "uid": "loki" },
          "gridPos": { "h": 14, "w": 24, "x": 0, "y": 43 },
          "options": {
            "showTime": true,
            "showLabels": true,
            "showCommonLabels": false,
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "dedupStrategy": "none",
            "sortOrder": "Descending"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "loki", "uid": "loki" },
              "queryType": "range",
              "expr": "{container=~\".+\"}"
            }
          ]
        }
      ]
    }
  ]
}
